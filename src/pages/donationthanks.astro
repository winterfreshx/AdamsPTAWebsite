---
import MessageLayout from '../layouts/MessageLayout.astro';
import { site } from '../data/site';
---

<MessageLayout title="Thank You" heading="Thank you so much for your donation to Adams Elementary!">
  <p>Your generosity supports every student, teacher and staff member at Adams.</p>
  <p>Adams Elementary PTA Tax ID: <strong>{site.taxId}</strong></p>
  <div class="btn-row">
    <a class="btn btn-accent" href="/corporate-matching">Get your gift matched</a>
    <a class="btn btn-ghost" href="/">Back to home</a>
  </div>
</MessageLayout>
