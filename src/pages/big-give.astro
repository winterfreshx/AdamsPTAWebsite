---
import { inbox } from '../data/contacts';
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import Icon from '../components/Icon.astro';
import banner from '../assets/images/big-give-banner.jpg';
import { links } from '../data/links';
import { bigGive } from '../data/announcements';
import { site, school } from '../data/site';
import { usd as fmt } from '../lib/format';
import BigGiveProgress from '../components/BigGiveProgress.astro';
import { bigGiveSupporters } from '../data/sponsors';
---

<BaseLayout title="The Big Give" description={`The Adams PTA Big Give runs ${bigGive.dates}. Help us reach our ${fmt(bigGive.goal)} community goal.`}>
  <PageHero eyebrow={`The Big Give · ${bigGive.dates}`} title="Donate today!" intro="The PTA appreciates any and all amounts families and sponsors are able to contribute.">
    <div class="btn-row stack-mobile">
      <a class="btn btn-accent btn-lg" href={links.donateBigGive}><Icon name="heart" /> Donate now</a>
      <a class="btn btn-light btn-lg" href="/corporate-matching"><Icon name="briefcase" /> Get it matched</a>
      {/* Same-site, so the external-link middleware skips it: new tab and screen-reader note are added by hand. */}
      <a class="btn btn-light btn-lg" href={bigGive.pledgeForm} target="_blank" rel="noopener"><Icon name="download" /> Pledge form (PDF)<span class="visually-hidden"> (opens in a new tab)</span></a>
    </div>
    <Image slot="art" src={banner} alt="" width={420} class="bg-banner" />
  </PageHero>

  <section class="section" aria-labelledby="goal-title">
    <div class="container">
      <div class="section-head center">
        <p class="eyebrow">Our goal</p>
        <h2 id="goal-title">{fmt(bigGive.goal)} for Adams students</h2>
        <p>
          We ask families who are able to donate <strong>{fmt(bigGive.perChildAsk)} per child</strong> to supercharge our
          progress toward our community goal of {fmt(bigGive.goal)}, with a further {fmt(bigGive.corporateMatchGoal)}
          from corporate match.
        </p>
      </div>

      <div class="goals">
        <div class="goal ask">
          <span class="goal-num">{fmt(bigGive.perChildAsk)}</span>
          <span class="goal-label">suggested gift per child</span>
          <Icon name="heart" size={28} class="goal-icon" />
        </div>
        <div class="goal">
          <span class="goal-num">{fmt(bigGive.goal)}</span>
          <span class="goal-label">our community goal</span>
        </div>
        <div class="goal">
          <span class="goal-num">{fmt(bigGive.corporateMatchGoal)}</span>
          <span class="goal-label">corporate-match goal</span>
        </div>
      </div>
      <div class="progress-wrap"><BigGiveProgress size="feature" /></div>
      <p class="center"><a class="btn btn-accent btn-lg" href={links.donateBigGive}><Icon name="heart" /> Donate to the Big Give</a></p>
    </div>
  </section>

  <section class="section section-tint">
    <div class="container grid info-cards">
      <article class="card">
        <div class="card-head">
          <Icon name="briefcase" size={30} class="i" />
          <h3>Double it with a match</h3>
        </div>
        <p>Many employers match donations. Search our <a href="/corporate-matching">corporate matching list</a> and use Tax ID <strong>{site.taxId}</strong>.</p>
      </article>
      <article class="card">
        <div class="card-head">
          <Icon name="dollar" size={30} class="i" />
          <h3>Paying by check?</h3>
        </div>
        <p>
          Make it payable to <strong>{site.name}</strong>. Drop it at the school office, the Big Give playground table, or
          mail it to:
        </p>
        <address>{site.name}<br />{school.street}<br />{school.city}, {school.state} {school.zip}</address>
      </article>
      <article class="card">
        <div class="card-head">
          <Icon name="sparkles" size={30} class="i" />
          <h3>What it funds</h3>
        </div>
        <p>Tutors, playground and lunch staff, SEL programming, classroom supplies, assemblies and community events. <a href="/fundraising">See more</a>.</p>
      </article>
      <article class="card">
        <div class="card-head">
          <Icon name="mail" size={30} class="i" />
          <h3>Questions?</h3>
        </div>
        <p>For questions about corporate matches, email <a href={`mailto:${inbox.treasurer}`}>{inbox.treasurer}</a>.</p>
      </article>
    </div>
  </section>

  {bigGiveSupporters.length > 0 && (
    <section class="section" aria-labelledby="sponsors-title">
      <div class="container">
        <div class="section-head center">
          <p class="eyebrow">With gratitude</p>
          <h2 id="sponsors-title">Thank you to our business supporters of the Big Give</h2>
        </div>
        <ul class="sponsors" role="list">
          {bigGiveSupporters.map((s) => (
            <li>
              <a href={s.url}>
                {s.logo && <Image src={s.logo} alt="" width={320} class="logo" />}
                {s.name}
              </a>
            </li>
          ))}
        </ul>
      </div>
    </section>
  )}
</BaseLayout>

<style>
  :global(.bg-banner) { border-radius: var(--radius); box-shadow: var(--shadow-lg); width: min(100%, 26rem); }
  .goals { display: grid; gap: var(--space-5); grid-template-columns: repeat(auto-fit, minmax(min(100%, 16rem), 1fr)); margin-bottom: var(--space-6); }
  .progress-wrap { margin-bottom: var(--space-6); }
  .goal {
    display: flex; flex-direction: column; align-items: center; text-align: center; gap: var(--space-2);
    padding: var(--space-6) var(--space-5); border-radius: var(--radius-lg); background: var(--green-100); border: 1px solid #bcd9c6;
  }
  .goal.ask { background: var(--gold-100); border-color: var(--gold-300); color: var(--green-700); }
  .goals :global(.goal-icon) { color: var(--green-700); margin-top: var(--space-1); }
  .goal-num { font-family: var(--font-display); font-weight: 800; font-size: clamp(2.25rem, 1.8rem + 2vw, 3.25rem); color: var(--green-700); line-height: 1; }
  .goal-label { font-weight: 800; color: var(--ink-soft); }
  .card :global(.i) { color: var(--green-500); flex: none; }
  .card-head { display: flex; align-items: center; gap: var(--space-3); margin-bottom: var(--space-3); }
  .card-head h3 { margin: 0; }
  /* 2 × 2 on tablet and desktop, so the four cards never leave one alone on a row. */
  .info-cards { grid-template-columns: 1fr; }
  @media (min-width: 720px) { .info-cards { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  .card address { font-style: normal; margin-top: var(--space-2); }
  .sponsors { list-style: none; padding: 0; display: grid; gap: var(--space-3); grid-template-columns: repeat(2, minmax(0, 1fr)); }
  .sponsors li { margin: 0; display: flex; }
  .sponsors a {
    flex: 1; display: flex; flex-direction: column; align-items: center; justify-content: space-between; gap: var(--space-3);
    padding: var(--space-4) var(--space-3); text-align: center; text-decoration: none; line-height: 1.25;
    font-family: var(--font-display); font-weight: 800; font-size: 0.9375rem; color: var(--green-700);
    background: var(--white); border: 1px solid var(--line); border-radius: var(--radius);
    transition: border-color 0.15s ease, background-color 0.15s ease;
  }
  .sponsors a:hover { background: var(--green-100); border-color: #bcd9c6; }
  /* The name stays plain text so the external-link middleware keeps it and its icon together in one .ext-label. */
  .sponsors :global(.logo) { flex: none; height: 4rem; width: 100%; object-fit: contain; mix-blend-mode: multiply; }
  @media (min-width: 720px) {
    .sponsors { grid-template-columns: repeat(4, minmax(0, 1fr)); gap: var(--space-4); }
    .sponsors a { padding: var(--space-5) var(--space-4); font-size: 1rem; }
    .sponsors :global(.logo) { height: 5.5rem; }
  }
</style>
