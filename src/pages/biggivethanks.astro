---
import MessageLayout from '../layouts/MessageLayout.astro';
import takeCare from '../assets/images/eagle-take-care.png';
---

<MessageLayout title="Thank You for Giving" heading="Thank you for supporting the Adams Elementary PTA with the Big Give!" image={takeCare} imageAlt="Adams Elementary PTA eagle: We take care of each other">
  <p>
    Please ask your employer about corporate matches! For questions about a corporate match, or to report one, contact
    <a href="mailto:ptatreasurer@adamselementary.org">ptatreasurer@adamselementary.org</a>.
  </p>
  <div class="btn-row">
    <a class="btn btn-accent" href="/corporate-matching">Find your employer</a>
    <a class="btn btn-ghost" href="/">Back to home</a>
  </div>
</MessageLayout>
