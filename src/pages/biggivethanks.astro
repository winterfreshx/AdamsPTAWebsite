---
import { inbox } from '../data/contacts';
import MessageLayout from '../layouts/MessageLayout.astro';
import EmailLink from '../components/EmailLink.astro';
---

<MessageLayout title="Thank You for Giving" heading="Thank you for supporting the Adams Elementary PTA with the Big Give!">
  <p>
    Please ask your employer about corporate matches! For questions about a corporate match, or to report one, contact
    <EmailLink to={inbox.treasurer} />.
  </p>
  <Fragment slot="actions">
    <a class="btn btn-accent" href="/corporate-matching">Find your employer</a>
  </Fragment>
</MessageLayout>
