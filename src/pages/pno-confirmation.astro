---
import MessageLayout from '../layouts/MessageLayout.astro';
import EmailLink from '../components/EmailLink.astro';
import { schoolContacts } from '../data/contacts';
const { name, email } = schoolContacts.parentNightOut;
---

<MessageLayout title="Parent Night Out Confirmation" heading="Thank you for signing up for Parent Night Out!">
  <p>Please forward a copy of your receipt to {name} at <EmailLink to={email} />.</p>
  <Fragment slot="actions">
    <EmailLink class="btn" to={email} subject="Parent Night Out receipt">Email {name}</EmailLink>
  </Fragment>
</MessageLayout>
