---
import '../styles/global.css';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import AnnouncementBar from '../components/AnnouncementBar.astro';
import { site } from '../data/site';
import { TIME_ZONE } from '../data/schedule';
import { sitePath, withBase } from '../lib/paths';

interface Props {
  title: string;
  description?: string;
  noindex?: boolean;
}

const { title, description = site.description, noindex = false } = Astro.props;
const path = sitePath(Astro.url.pathname);
const fullTitle = path === '/' ? `${site.name} | Seattle, WA` : `${title} | ${site.name}`;
const canonical = new URL(withBase(path), Astro.site).href;
const ogImage = new URL(withBase('/og-image.png'), Astro.site).href;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    {noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonical} />}
    <meta name="theme-color" content="#105838" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />

    <noscript>
      <style>
        /* Without JS the mobile menu can't open or close, so show it inline. The header must not stay
           sticky, or the expanded menu would cover the page while scrolling. */
        @media (max-width: 999px) {
          .site-header { position: static !important; }
          .mobile-menu, .mobile-menu[hidden] { display: block !important; position: static !important; }
          .menu-toggle { display: none !important; }
        }
      </style>
    </noscript>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <AnnouncementBar />
    <SiteHeader />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <SiteFooter />

    <!-- Re-check scheduled content against today's Seattle date (see src/data/schedule.ts). -->
    <script is:inline define:vars={{ tz: TIME_ZONE }}>
      const today = new Intl.DateTimeFormat('en-CA', { timeZone: tz, year: 'numeric', month: '2-digit', day: '2-digit' }).format(new Date());
      const live = (el) => (!el.dataset.starts || el.dataset.starts <= today) && (!el.dataset.expires || el.dataset.expires >= today);
      document.querySelectorAll('[data-schedule]').forEach((el) => {
        el.hidden = live(el) === el.hasAttribute('data-invert');
      });
      document.querySelectorAll('[data-schedule-href]').forEach((a) => {
        a.href = live(a) ? a.dataset.hrefIn : a.dataset.hrefOut;
      });
    </script>
  </body>
</html>
